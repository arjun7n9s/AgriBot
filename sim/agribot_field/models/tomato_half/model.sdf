<?xml version="1.0"?>
<sdf version="1.9">
  <model name="tomato_half">
    <!-- Model origin = the knuckle (abscission zone). The world attaches the
         fruit to its plant here with a detachable joint; cutting the distal
         pedicel releases it. Semantic label 2 (config/semantic_labels.yaml). -->
    <link name="fruit">
      <inertial>
        <pose>0 0 -0.03589 0 0 0</pose>
        <mass>0.09</mass>
        <inertia><ixx>3.240e-05</ixx><iyy>3.240e-05</iyy><izz>3.240e-05</izz>
                 <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia>
      </inertial>
      <collision name="body">
        <pose>0 0 -0.03589 0 0 0</pose>
        <geometry><sphere><radius>0.0242</radius></sphere></geometry>
        <surface><friction><ode><mu>0.8</mu><mu2>0.8</mu2></ode></friction>
                 <bounce><restitution_coefficient>0.05</restitution_coefficient></bounce>
                 <!-- Collision group 0x04 (fruit on the plant): the robot (0x01, 0x03) passes
                      through it. A cut fruit is respawned in group 0x02, which the cutter
                      cradle and the crate catch (agribot_gazebo/scripts/harvest_demo.py). -->
                 <contact><collide_bitmask>0x04</collide_bitmask></contact></surface>
      </collision>
      <visual name="visual">
        <geometry><mesh><uri>model://tomato_half/meshes/tomato_half.obj</uri></mesh></geometry>
      </visual>
    </link>
    <frame name="cut_point"><pose relative_to="fruit">0 0 -0.0060 0 0 0</pose></frame>
  </model>
</sdf>
