<?xml version="1.0"?>
<sdf version="1.9">
  <model name="raised_bed">
    <static>true</static>
    <!-- 2.7 m bed segment, tile along +x. Origin at the start of the segment, on
         the bed centreline, at ground level. Plant holes at x = 0.225 + 0.45 i,
         y = +/-0.30. Collision is the bed's trapezoid as two boxes. -->
    <link name="bed">
      <collision name="core">
        <pose>1.35 0 0.075 0 0 0</pose>
        <geometry><box><size>2.7 0.9 0.15</size></box></geometry>
      </collision>
      <collision name="shoulders">
        <pose>1.35 0 0.0375 0 0 0</pose>
        <geometry><box><size>2.7 1.0 0.075</size></box></geometry>
      </collision>
      <visual name="visual">
        <geometry><mesh><uri>model://raised_bed/meshes/raised_bed.obj</uri></mesh></geometry>
      </visual>
    </link>
  </model>
</sdf>
