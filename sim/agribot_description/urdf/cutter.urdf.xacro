<?xml version="1.0"?>
<!--
  AgriBOT robot description. Generated by tools/description/write_urdf.py from
  measured and estimated data; edit the generator, not this file.
  V-capture bypass cutter, concept v0 (docs/scara-redesign.md, section 3).
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
<xacro:macro name="agribot_cutter" params="prefix">
  <link name="${prefix}cutter_body">
    <inertial>
      <!-- estimate: two MG996R, PETG body, camera (docs/scara-redesign.md) -->
      <origin xyz="0.03 0 -0.07" rpy="0 0 0"/>
      <mass value="0.28"/>
      <inertia ixx="0.000714" ixy="0" ixz="0" iyy="0.000919333" iyz="0" izz="0.000583333"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><mesh filename="package://agribot_description/meshes/cutter/visual/cutter_body.obj"/></geometry>
    </visual>
    <collision name="top_plate">
      <origin xyz="0.051 0 -0.05" rpy="0 0 0"/>
      <geometry><box size="0.134 0.084 0.004"/></geometry>
    </collision>
    <collision name="spine">
      <origin xyz="-0.012 0 -0.0765" rpy="0 0 0"/>
      <geometry><box size="0.008 0.09 0.147"/></geometry>
    </collision>
    <collision name="wall_right">
      <origin xyz="0.046 0.0435 -0.119" rpy="0 0 0"/>
      <geometry><box size="0.108 0.003 0.042"/></geometry>
    </collision>
    <collision name="wall_left">
      <origin xyz="0.046 -0.0435 -0.119" rpy="0 0 0"/>
      <geometry><box size="0.108 0.003 0.042"/></geometry>
    </collision>
    <collision name="servo1">
      <origin xyz="0.0263 0.0298 -0.0255" rpy="0 0 0"/>
      <geometry><box size="0.0407 0.0197 0.037"/></geometry>
    </collision>
    <collision name="camera">
      <origin xyz="-0.002 -0.07 -0.084" rpy="0 0 0"/>
      <geometry><box size="0.03 0.046 0.042"/></geometry>
    </collision>
  </link>
  <link name="${prefix}cutter_blade">
    <inertial>
      <!-- estimate -->
      <origin xyz="0.01 0 0.001" rpy="0 0 0"/>
      <mass value="0.008"/>
      <inertia ixx="7.73333e-08" ixy="0" ixz="0" iyy="6.10667e-07" iyz="0" izz="6.66667e-07"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><mesh filename="package://agribot_description/meshes/cutter/visual/cutter_blade.obj"/></geometry>
    </visual>
  </link>
  <link name="${prefix}cutter_door">
    <inertial>
      <!-- estimate -->
      <origin xyz="-0.052 0 0.004" rpy="0 0 0"/>
      <mass value="0.03"/>
      <inertia ixx="1.7525e-05" ixy="0" ixz="0" iyy="2.73425e-05" iyz="0" izz="4.42625e-05"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><mesh filename="package://agribot_description/meshes/cutter/visual/cutter_door.obj"/></geometry>
    </visual>
    <collision name="floor">
      <origin xyz="-0.052 0 0.0065" rpy="0 0 0"/>
      <geometry><box size="0.104 0.083 0.011"/></geometry>
    </collision>
    <collision name="lip">
      <origin xyz="0.002 0 0.015" rpy="0 0 0"/>
      <geometry><box size="0.004 0.083 0.024"/></geometry>
    </collision>
  </link>
  <link name="${prefix}cut_point"/>
  <link name="${prefix}tool0"/>
  <link name="${prefix}arm_camera_link"/>
  <link name="${prefix}arm_camera_link_optical_frame"/>
  <joint name="${prefix}arm_camera_link_optical_joint" type="fixed">
    <parent link="${prefix}arm_camera_link"/>
    <child link="${prefix}arm_camera_link_optical_frame"/>
    <origin xyz="0 0 0" rpy="-1.5708 0 -1.5708"/>
  </joint>
  <joint name="${prefix}cutter_mount" type="fixed">
    <parent link="${prefix}tool_flange"/>
    <child link="${prefix}cutter_body"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>
  <joint name="${prefix}cutter_blade_joint" type="revolute">
    <!-- 0 = open, lower limit = fully closed across the throat -->
    <parent link="${prefix}cutter_body"/>
    <child link="${prefix}cutter_blade"/>
    <origin xyz="0.048 0.014 -0.047" rpy="0 0 0.261799"/>
    <axis xyz="0 0 1"/>
    <limit lower="-1.22173" upper="0" effort="0.9" velocity="3"/>
    <dynamics damping="0.01" friction="0.002"/>
  </joint>
  <joint name="${prefix}cutter_door_joint" type="revolute">
    <!-- 0 = closed; positive swings the floor down to drop the fruit -->
    <parent link="${prefix}cutter_body"/>
    <child link="${prefix}cutter_door"/>
    <origin xyz="0.098 0 -0.14" rpy="0 0 0"/>
    <axis xyz="0 -1 0"/>
    <limit lower="0" upper="1.309" effort="0.9" velocity="3"/>
    <dynamics damping="0.01" friction="0.002"/>
  </joint>
  <joint name="${prefix}cut_point_joint" type="fixed">
    <!-- centre of the 6 mm throat: the pedicel is cut here -->
    <parent link="${prefix}cutter_body"/>
    <child link="${prefix}cut_point"/>
    <origin xyz="0.0655 0 -0.05" rpy="0 0 0"/>
  </joint>
  <joint name="${prefix}tool0_joint" type="fixed">
    <parent link="${prefix}cutter_body"/>
    <child link="${prefix}tool0"/>
    <origin xyz="0.0655 0 -0.05" rpy="0 0 0"/>
  </joint>
  <joint name="${prefix}arm_camera_joint" type="fixed">
    <!-- RGB-D camera front face, pitched down -->
    <parent link="${prefix}cutter_body"/>
    <child link="${prefix}arm_camera_link"/>
    <origin xyz="0.00820322 -0.0645749 -0.085011" rpy="0 0.0872665 0.488692"/>
  </joint>
</xacro:macro>
</robot>
