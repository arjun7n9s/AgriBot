<?xml version="1.0"?>
<!--
  AgriBOT robot description. Generated by tools/description/write_urdf.py from
  measured and estimated data; edit the generator, not this file.
  SCARA arm (HowToMechatronics design, measured from its STEP): L1 0.22798 m, L2 0.13649 m, Z stroke 0.249 m.
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
<xacro:macro name="agribot_scara" params="prefix">
  <link name="${prefix}base_link">
    <inertial>
      <!-- estimate: mesh volumes x effective density: printed 560 kg/m3, metal 7850 kg/m3, motor 3800 kg/m3, belt 1200 kg/m3, switch 1500 kg/m3. Estimates; weigh the real parts. -->
      <origin xyz="-0.0712791 0.00956844 0.0371431" rpy="0 0 0"/>
      <mass value="0.833682"/>
      <inertia ixx="0.00124008" ixy="0.000315526" ixz="0.000159535" iyy="0.00418148" iyz="-0.000150768" izz="0.00491594"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><mesh filename="package://agribot_description/meshes/scara/visual/base_link.obj"/></geometry>
    </visual>
    <collision>
      <geometry><mesh filename="package://agribot_description/meshes/scara/collision/base_link.stl"/></geometry>
    </collision>
  </link>
  <link name="${prefix}column_link">
    <inertial>
      <!-- estimate: mesh volumes x effective density: printed 560 kg/m3, metal 7850 kg/m3, motor 3800 kg/m3, belt 1200 kg/m3, switch 1500 kg/m3. Estimates; weigh the real parts. -->
      <origin xyz="0.00742286 3.44212e-06 0.228887" rpy="0 0 0"/>
      <mass value="1.80729"/>
      <inertia ixx="0.0462066" ixy="-1.87405e-09" ixz="-0.00165238" iyy="0.0465499" iyz="-1.66436e-07" izz="0.00324059"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><mesh filename="package://agribot_description/meshes/scara/visual/column_link.obj"/></geometry>
    </visual>
    <collision>
      <geometry><mesh filename="package://agribot_description/meshes/scara/collision/column_link.stl"/></geometry>
    </collision>
  </link>
  <link name="${prefix}carriage_link">
    <inertial>
      <!-- estimate: mesh volumes x effective density: printed 560 kg/m3, metal 7850 kg/m3, motor 3800 kg/m3, belt 1200 kg/m3, switch 1500 kg/m3. Estimates; weigh the real parts. -->
      <origin xyz="0.0811465 -8.9567e-07 0.0295613" rpy="0 0 0"/>
      <mass value="0.946238"/>
      <inertia ixx="0.0011079" ixy="7.57917e-07" ixz="0.00164601" iyy="0.0110148" iyz="-3.88306e-07" izz="0.0109244"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><mesh filename="package://agribot_description/meshes/scara/visual/carriage_link.obj"/></geometry>
    </visual>
    <collision>
      <geometry><mesh filename="package://agribot_description/meshes/scara/collision/carriage_link.stl"/></geometry>
    </collision>
  </link>
  <link name="${prefix}arm2_link">
    <inertial>
      <!-- estimate: mesh volumes x effective density: printed 560 kg/m3, metal 7850 kg/m3, motor 3800 kg/m3, belt 1200 kg/m3, switch 1500 kg/m3. Estimates; weigh the real parts. -->
      <origin xyz="0.0691927 8.7085e-07 -0.0313833" rpy="0 0 0"/>
      <mass value="0.569879"/>
      <inertia ixx="0.000428514" ixy="2.76917e-07" ixz="-4.59967e-05" iyy="0.00300115" iyz="-2.11427e-07" izz="0.00292892"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><mesh filename="package://agribot_description/meshes/scara/visual/arm2_link.obj"/></geometry>
    </visual>
    <collision>
      <geometry><mesh filename="package://agribot_description/meshes/scara/collision/arm2_link.stl"/></geometry>
    </collision>
  </link>
  <link name="${prefix}wrist_link">
    <inertial>
      <!-- estimate: mesh volumes x effective density: printed 560 kg/m3, metal 7850 kg/m3, motor 3800 kg/m3, belt 1200 kg/m3, switch 1500 kg/m3. Estimates; weigh the real parts. -->
      <origin xyz="0.000443116 -0.000165271 -7.39752e-05" rpy="0 0 0"/>
      <mass value="0.0372179"/>
      <inertia ixx="1.9538e-05" ixy="-2.60341e-08" ixz="1.66016e-07" iyy="1.94947e-05" iyz="-7.77842e-08" izz="2.00665e-05"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><mesh filename="package://agribot_description/meshes/scara/visual/wrist_link.obj"/></geometry>
    </visual>
    <collision>
      <geometry><mesh filename="package://agribot_description/meshes/scara/collision/wrist_link.stl"/></geometry>
    </collision>
  </link>
  <link name="${prefix}tool_flange"/>
  <joint name="${prefix}j1" type="revolute">
    <!-- limits: assumed; set from the J1 home switch and cabling; effort/velocity: estimate -->
    <parent link="${prefix}base_link"/>
    <child link="${prefix}column_link"/>
    <origin xyz="0 0 0.035" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-2.96706" upper="2.96706" effort="2" velocity="1"/>
    <dynamics damping="0.5" friction="0.05"/>
  </joint>
  <joint name="${prefix}z" type="prismatic">
    <!-- limits: part clearances in the STEP: platform on base cover, J2 motor at the Z top limit switch; effort/velocity: estimate -->
    <parent link="${prefix}column_link"/>
    <child link="${prefix}carriage_link"/>
    <origin xyz="0 0 0.0625" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="0" upper="0.249" effort="100" velocity="0.05"/>
    <dynamics damping="20" friction="1"/>
  </joint>
  <joint name="${prefix}j2" type="revolute">
    <!-- limits: assumed; check Arm 2 against the column; effort/velocity: estimate -->
    <parent link="${prefix}carriage_link"/>
    <child link="${prefix}arm2_link"/>
    <origin xyz="0.227977 0 -0.019" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-2.61799" upper="2.61799" effort="3" velocity="1.2"/>
    <dynamics damping="0.3" friction="0.05"/>
  </joint>
  <joint name="${prefix}j3" type="revolute">
    <!-- limits: assumed; keeps the tool cables from winding up; effort/velocity: estimate -->
    <parent link="${prefix}arm2_link"/>
    <child link="${prefix}wrist_link"/>
    <origin xyz="0.136488 0 -0.039" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-2.61799" upper="2.61799" effort="0.8" velocity="2"/>
    <dynamics damping="0.05" friction="0.01"/>
  </joint>
  <joint name="${prefix}tool_flange_joint" type="fixed">
    <!-- J3 coupler underside; tools bolt on here -->
    <parent link="${prefix}wrist_link"/>
    <child link="${prefix}tool_flange"/>
    <origin xyz="0 0 -0.018" rpy="0 0 0"/>
  </joint>
</xacro:macro>
</robot>
