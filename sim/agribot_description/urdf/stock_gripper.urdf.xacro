<?xml version="1.0"?>
<!--
  AgriBOT robot description. Generated by tools/description/write_urdf.py from
  measured and estimated data; edit the generator, not this file.
  Stock HowToMechatronics gripper.
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
<xacro:macro name="agribot_stock_gripper" params="prefix">
  <link name="${prefix}stock_gripper">
    <inertial>
      <!-- estimate from mesh volumes -->
      <origin xyz="-0.0091636 0.00862731 -0.047921" rpy="0 0 0"/>
      <mass value="0.255159"/>
      <inertia ixx="0.00025594" ixy="-5.56302e-05" ixz="-3.44136e-06" iyy="0.000248573" iyz="3.42056e-06" izz="0.000235372"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><mesh filename="package://agribot_description/meshes/scara/visual/stock_gripper.obj"/></geometry>
    </visual>
    <collision>
      <geometry><mesh filename="package://agribot_description/meshes/scara/collision/stock_gripper.stl"/></geometry>
    </collision>
  </link>
  <link name="${prefix}tool0"/>
  <joint name="${prefix}stock_gripper_mount" type="fixed">
    <parent link="${prefix}tool_flange"/>
    <child link="${prefix}stock_gripper"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>
  <joint name="${prefix}stock_gripper_tool0" type="fixed">
    <!-- bottom of the gripper fingers -->
    <parent link="${prefix}stock_gripper"/>
    <child link="${prefix}tool0"/>
    <origin xyz="0 0 -0.115" rpy="0 0 0"/>
  </joint>
</xacro:macro>
</robot>
