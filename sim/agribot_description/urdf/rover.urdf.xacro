<?xml version="1.0"?>
<!--
  AgriBOT robot description. Generated by tools/description/write_urdf.py from
  measured and estimated data; edit the generator, not this file.
  Ride-on rover chassis at measured size; wheelbase, track and steer limit assumed.
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
<xacro:macro name="agribot_rover" params="prefix">
  <link name="${prefix}base_footprint"/>
  <link name="${prefix}base_link">
    <inertial>
      <!-- estimate: ride-on chassis with batteries -->
      <origin xyz="0 0 0.205" rpy="0 0 0"/>
      <mass value="30"/>
      <inertia ixx="1.4065" ixy="0" ixz="0" iyy="4.00525" iyz="0" izz="3.89925"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><mesh filename="package://agribot_description/meshes/rover/visual/rover_body.obj"/></geometry>
    </visual>
    <collision>
      <origin xyz="0 0 0.205" rpy="0 0 0"/>
      <geometry><box size="1.14 0.51 0.55"/></geometry>
    </collision>
  </link>
  <joint name="${prefix}base_joint" type="fixed">
    <parent link="${prefix}base_footprint"/>
    <child link="${prefix}base_link"/>
    <origin xyz="0 0 0.19" rpy="0 0 0"/>
  </joint>
  <link name="${prefix}steer_link">
    <inertial>
      <!-- estimate -->
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.5"/>
      <inertia ixx="0.00514167" ixy="0" ixz="0" iyy="0.000141667" iyz="0" izz="0.00520833"/>
    </inertial>
  </link>
  <joint name="${prefix}steer_joint" type="revolute">
    <!-- one steering motor, parallel steer until the real linkage is measured; wheelbase, track and limit are assumed (docs/work-plan.md) -->
    <parent link="${prefix}base_link"/>
    <child link="${prefix}steer_link"/>
    <origin xyz="0.36 0 0" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-0.436332" upper="0.436332" effort="20" velocity="1"/>
    <dynamics damping="1" friction="0.1"/>
  </joint>
  <link name="${prefix}front_left_wheel">
    <inertial>
      <!-- estimate -->
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="1.5"/>
      <inertia ixx="0.01635" ixy="0" ixz="0" iyy="0.027075" iyz="0" izz="0.01635"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><mesh filename="package://agribot_description/meshes/rover/visual/wheel.obj"/></geometry>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry><cylinder radius="0.19" length="0.15"/></geometry>
    </collision>
  </link>
  <joint name="${prefix}front_left_wheel_joint" type="continuous">
    <parent link="${prefix}steer_link"/>
    <child link="${prefix}front_left_wheel"/>
    <origin xyz="0 0.275 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit effort="40" velocity="6"/>
    <dynamics damping="0.2" friction="0.05"/>
  </joint>
  <link name="${prefix}front_right_wheel">
    <inertial>
      <!-- estimate -->
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="1.5"/>
      <inertia ixx="0.01635" ixy="0" ixz="0" iyy="0.027075" iyz="0" izz="0.01635"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><mesh filename="package://agribot_description/meshes/rover/visual/wheel.obj"/></geometry>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry><cylinder radius="0.19" length="0.15"/></geometry>
    </collision>
  </link>
  <joint name="${prefix}front_right_wheel_joint" type="continuous">
    <parent link="${prefix}steer_link"/>
    <child link="${prefix}front_right_wheel"/>
    <origin xyz="0 -0.275 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit effort="40" velocity="6"/>
    <dynamics damping="0.2" friction="0.05"/>
  </joint>
  <link name="${prefix}rear_left_wheel">
    <inertial>
      <!-- estimate -->
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="1.5"/>
      <inertia ixx="0.01635" ixy="0" ixz="0" iyy="0.027075" iyz="0" izz="0.01635"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><mesh filename="package://agribot_description/meshes/rover/visual/wheel.obj"/></geometry>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry><cylinder radius="0.19" length="0.15"/></geometry>
    </collision>
  </link>
  <joint name="${prefix}rear_left_wheel_joint" type="continuous">
    <parent link="${prefix}base_link"/>
    <child link="${prefix}rear_left_wheel"/>
    <origin xyz="-0.36 0.275 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit effort="40" velocity="6"/>
    <dynamics damping="0.2" friction="0.05"/>
  </joint>
  <link name="${prefix}rear_right_wheel">
    <inertial>
      <!-- estimate -->
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="1.5"/>
      <inertia ixx="0.01635" ixy="0" ixz="0" iyy="0.027075" iyz="0" izz="0.01635"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><mesh filename="package://agribot_description/meshes/rover/visual/wheel.obj"/></geometry>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry><cylinder radius="0.19" length="0.15"/></geometry>
    </collision>
  </link>
  <joint name="${prefix}rear_right_wheel_joint" type="continuous">
    <parent link="${prefix}base_link"/>
    <child link="${prefix}rear_right_wheel"/>
    <origin xyz="-0.36 -0.275 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit effort="40" velocity="6"/>
    <dynamics damping="0.2" friction="0.05"/>
  </joint>
  <link name="${prefix}front_camera_link"/>
  <link name="${prefix}front_camera_link_optical_frame"/>
  <joint name="${prefix}front_camera_link_optical_joint" type="fixed">
    <parent link="${prefix}front_camera_link"/>
    <child link="${prefix}front_camera_link_optical_frame"/>
    <origin xyz="0 0 0" rpy="-1.5708 0 -1.5708"/>
  </joint>
  <joint name="${prefix}front_camera_joint" type="fixed">
    <parent link="${prefix}base_link"/>
    <child link="${prefix}front_camera_link"/>
    <origin xyz="0.602 0 0.36" rpy="0 0 0"/>
  </joint>
  <link name="${prefix}rear_camera_link"/>
  <link name="${prefix}rear_camera_link_optical_frame"/>
  <joint name="${prefix}rear_camera_link_optical_joint" type="fixed">
    <parent link="${prefix}rear_camera_link"/>
    <child link="${prefix}rear_camera_link_optical_frame"/>
    <origin xyz="0 0 0" rpy="-1.5708 0 -1.5708"/>
  </joint>
  <joint name="${prefix}rear_camera_joint" type="fixed">
    <parent link="${prefix}base_link"/>
    <child link="${prefix}rear_camera_link"/>
    <origin xyz="-0.607 0 0.29" rpy="0 0 3.14159"/>
  </joint>
  <link name="${prefix}imu_link"/>
  <joint name="${prefix}imu_joint" type="fixed">
    <parent link="${prefix}base_link"/>
    <child link="${prefix}imu_link"/>
    <origin xyz="0 0 0.26" rpy="0 0 0"/>
  </joint>
  <link name="${prefix}harvest_crate">
    <inertial>
      <!-- estimate, empty -->
      <origin xyz="0 0 0.1" rpy="0 0 0"/>
      <mass value="0.6"/>
      <inertia ixx="0.0065" ixy="0" ixz="0" iyy="0.01" iyz="0" izz="0.0125"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><mesh filename="package://agribot_description/meshes/rover/visual/harvest_crate.obj"/></geometry>
    </visual>
  </link>
  <joint name="${prefix}harvest_crate_joint" type="fixed">
    <parent link="${prefix}base_link"/>
    <child link="${prefix}harvest_crate"/>
    <origin xyz="-0.36 0.02 0.335" rpy="0 0 0"/>
  </joint>
  <link name="${prefix}scout_mast">
    <inertial>
      <!-- estimate -->
      <origin xyz="0 0 0.25" rpy="0 0 0"/>
      <mass value="0.4"/>
      <inertia ixx="0.00838667" ixy="0" ixz="0" iyy="0.00838667" iyz="0" izz="0.000106667"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><mesh filename="package://agribot_description/meshes/rover/visual/scout_mast.obj"/></geometry>
    </visual>
  </link>
  <joint name="${prefix}scout_mast_joint" type="fixed">
    <parent link="${prefix}base_link"/>
    <child link="${prefix}scout_mast"/>
    <origin xyz="-0.5 0.2 0.335" rpy="0 0 0"/>
  </joint>
  <link name="${prefix}scout_pan_link">
    <inertial>
      <!-- estimate -->
      <origin xyz="0 0 0.05" rpy="0 0 0"/>
      <mass value="0.15"/>
      <inertia ixx="0.00018125" ixy="0" ixz="0" iyy="0.00014125" iyz="0" izz="0.0001625"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><mesh filename="package://agribot_description/meshes/rover/visual/scout_head.obj"/></geometry>
    </visual>
  </link>
  <joint name="${prefix}scout_pan_joint" type="revolute">
    <!-- pan mechanism for the rotating scouting camera -->
    <parent link="${prefix}scout_mast"/>
    <child link="${prefix}scout_pan_link"/>
    <origin xyz="0 0 0.5" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-3.14159" upper="3.14159" effort="1" velocity="1.5"/>
    <dynamics damping="0.05" friction="0.01"/>
  </joint>
  <link name="${prefix}scout_camera_link"/>
  <link name="${prefix}scout_camera_link_optical_frame"/>
  <joint name="${prefix}scout_camera_link_optical_joint" type="fixed">
    <parent link="${prefix}scout_camera_link"/>
    <child link="${prefix}scout_camera_link_optical_frame"/>
    <origin xyz="0 0 0" rpy="-1.5708 0 -1.5708"/>
  </joint>
  <joint name="${prefix}scout_camera_joint" type="fixed">
    <parent link="${prefix}scout_pan_link"/>
    <child link="${prefix}scout_camera_link"/>
    <origin xyz="0.04 0 0.06" rpy="0 0 0"/>
  </joint>
  <link name="${prefix}scara_mast">
    <inertial>
      <!-- estimate -->
      <origin xyz="0 0 0.475" rpy="0 0 0"/>
      <mass value="2.5"/>
      <inertia ixx="0.188354" ixy="0" ixz="0" iyy="0.189354" iyz="0" izz="0.00166667"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><mesh filename="package://agribot_description/meshes/rover/visual/scara_mast.obj"/></geometry>
    </visual>
    <collision>
      <origin xyz="0 0 0.475" rpy="0 0 0"/>
      <geometry><box size="0.08 0.04 0.95"/></geometry>
    </collision>
  </link>
  <joint name="${prefix}scara_mast_joint" type="fixed">
    <!-- side mast; the SCARA base pins on at one of five heights -->
    <parent link="${prefix}base_link"/>
    <child link="${prefix}scara_mast"/>
    <origin xyz="-0.12 -0.3 -0.11" rpy="0 0 0"/>
  </joint>
</xacro:macro>
</robot>
